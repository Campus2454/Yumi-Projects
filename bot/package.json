  "dependencies": {
    "@google-cloud/pubsub": "^4.8.0",
    "@types/express-xml-bodyparser": "^0.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "axios": "^1.6.8",
    "body-parser": "^1.20.3",
    "discord-api-types": "^0.38.9",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "express": "^4.21.1",
    "express-xml-bodyparser": "^0.3.0",
    "global": "../global",
    "googleapis": "^144.0.0",
    "mysql2": "^3.11.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.15",
    "pm2": "^6.0.5",
    "readline": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "dev": "cross-env IS_DEV=true nodemon ./src/index.ts",
    "start": "cross-env IS_DEV=false node ./build/src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --only Camming && pm2 logs Camming --raw",
    "pm2:restart": "pm2 restart Camming && pm2 logs Camming --raw",
    "pm2:stop": "pm2 stop Camming",
    "pm2:dev:start": "pm2 start ecosystem.config.js --only CammingTest && pm2 logs CammingTest --raw",
    "pm2:dev:restart": "pm2 restart CammingTest && pm2 logs CammingTest --raw",
    "pm2:dev:stop": "pm2 stop CammingTest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "dotenv -e .env -- bash -c 'curl -X GET \"https://coolify.yumistack.net/api/v1/deploy?uuid=idu3l7e7oc2k88cjx9pwkylu\" -H \"Authorization: Bearer $COOLIFY_TOKEN\"'",
    "register": "node ./src/RegisterCommand.js",
    "status": "ts-node ./statusChecker.ts",
    "youtube": "nodemon ./src/notifier/youtube.ts",
    "closing": "ts-node ./src/temporaryClosing.ts"
  },
  "packageManager": "yarn@4.11.0"
}
