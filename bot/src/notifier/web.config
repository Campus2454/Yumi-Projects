<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="page">
                    <match url="*" />
                    <action type="Rewrite" url="http://localehost:3010/youtube" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
